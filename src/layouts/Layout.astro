---
import StructuredData from './StructuredData.astro';
import { COMPANY_NAME, COMPANY_TAGLINE } from '../constants';

interface Props {
  title?: string;
}

const { title = COMPANY_NAME } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`${COMPANY_NAME} - ${COMPANY_TAGLINE}`}
    />
    <title>{title}</title>
    
    <!-- Structured Data (JSON-LD) -->
    <StructuredData />
  </head>
  <body>
    <slot />
    <footer class="bg-red-900 text-white py-8 px-4">
      <div class="max-w-6xl mx-auto text-center">
        <p class="text-red-200">
          &copy; {new Date().getFullYear()} {COMPANY_NAME}. All rights
          reserved.
        </p>
      </div>
    </footer>
  </body>
</html>