---
import { COMPANY_NAME, COMPANY_DESCRIPTION, COMPANY_URL, COMPANY_LOGO_URL, COMPANY_ADDRESS, COMPANY_COORDINATES } from '../constants';

// Structured Data
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    // Organization Schema
    {
      "@type": "Organization",
      "@id": COMPANY_URL,
      "name": COMPANY_NAME,
      "url": COMPANY_URL,
      "logo": {
        "@type": "ImageObject",
        "url": COMPANY_LOGO_URL,
        "width": 600,
        "height": 60
      },
      "description": COMPANY_DESCRIPTION,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": COMPANY_ADDRESS.street,
        "addressLocality": COMPANY_ADDRESS.city,
        "addressRegion": COMPANY_ADDRESS.province,
        "postalCode": COMPANY_ADDRESS.postal,
        "addressCountry": COMPANY_ADDRESS.country
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": COMPANY_COORDINATES.latitude,
        "longitude": COMPANY_COORDINATES.longitude
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "areaServed": "CA",
        "availableLanguage": ["English"]
      },
      "sameAs": [
        "https://hanssteel.com",
        "https://hanscons.com"
      ]
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />